/dts-v1/;
/plugin/;

#include <dt-bindings/clock/tegra234-clock.h>
#include <dt-bindings/gpio/tegra234-gpio.h>
#include <dt-bindings/tegra234-p3737-0000+p3701-0000.h>
/* camera control gpio definitions */
#define CAM0_RST_L		TEGRA234_MAIN_GPIO(H, 3) //tca9543
#define CAM0_PWDN		TEGRA234_MAIN_GPIO(H, 6)
//#define CAM1_RST_L		TEGRA234_MAIN_GPIO(AC, 1)
#define CAM1_PWDN		TEGRA234_MAIN_GPIO(AC, 0)
#define CAMERA_I2C_MUX_BUS(x) (0x1E + x)

/ {
    overlay-name = "Jetson Sensing SG8A-AGON-G2Y-A1 SIPL GMSL2x8";
	jetson-header-name = "Jetson AGX CSI Connector";
	compatible = JETSON_COMPATIBLE;


    fragment@0 {
        target-path = "/bus@0";
        __overlay__ {

            /* ensure camera reset GPIO is asserted so I2C mux powers up */
            gpio@2200000 {
                camera-control-output-high{
                    gpio-hog;
                    output-high;
                    gpios = <CAM0_RST_L 0>;
					label = "cam0-rst";
                    
                };
            };

            i2c@3180000 {
                status = "okay";
                #address-cells = <1>;
                #size-cells = <0>;
                clock-frequency = <100000>;
                tca9543@70 {
                    compatible = "nxp,pca9543";
                    reg = <0x70>;
                    status = "okay";
                    #address-cells = <1>;
                    #size-cells = <0>;
                    skip_mux_detect = "yes";
                    force_bus_start = <CAMERA_I2C_MUX_BUS(0)>;

                    i2c@0 {
                        status = "okay";
						reg = <0>;
						i2c-mux,deselect-on-exit;
						#address-cells = <1>;
						#size-cells = <0>;

                        max96712_ab@29 {
                            compatible = "nvidia,max96712_0";
                            reg = <0x29>;
                            status = "okay";
                        };
                    };

                    i2c@1 {
                        status = "okay";
						reg = <1>;
						i2c-mux,deselect-on-exit;
						#address-cells = <1>;
						#size-cells = <0>;

                        max96712_cd@2d {
                            compatible = "nvidia,max96712_1";
                            reg = <0x2d>;
                            status = "okay";
                        };
                    };
                };
            };
        };
    };
};